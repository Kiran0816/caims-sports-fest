# Copy to backend/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development            # set to "production" when deployed (enables Secure cookies, needs HTTPS)

# SQLite for local dev. For PostgreSQL use: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:./data/caims.sqlite
DATABASE_SSL=false              # true for hosted Postgres that requires SSL

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
SESSION_EXPIRES=8h

# First super admin, created by "npm run db:seed" only when no admin exists.
# IMPORTANT: keep the quotes. An unquoted # starts a comment in .env files.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD="caimsfest2026#"

# Optional
# UPLOAD_DIR=/var/data/uploads   # persistent folder for photos
# TRUST_PROXY=1                  # set when behind a reverse proxy/host (Render, Railway, nginx)
# ALLOWED_ORIGINS=               # comma-separated extra origins allowed to call the API
