{
  "name": "caims-sports-fest-2026",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix backend install --include=dev && npm --prefix frontend install --include=dev",
    "db:init": "npm --prefix backend run db:init",
    "db:seed": "npm --prefix backend run db:seed",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test:api": "npm --prefix backend test"
  }
}
